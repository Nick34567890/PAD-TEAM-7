# Copy to .env and replace every change_me. .env is git-ignored — never commit real secrets.

# Shared by every service: signs service-to-service tokens (HS256).
SERVICE_JWT_SECRET=change_me

# Player tokens. While Player Service is not deployed, leave PLAYER_JWKS_URL empty: tokens are then
# mocked (HS256 with MOCK_PLAYER_JWT_SECRET) and POST /api/v1/dev/tokens issues test tokens.
PLAYER_JWKS_URL=
MOCK_PLAYER_JWT_SECRET=change_me
AUTH_DEV_TOKENS=true

# One private database per service.
EXAM_DB_USER=exam
EXAM_DB_PASSWORD=change_me
WORLD_DB_USER=world
WORLD_DB_PASSWORD=change_me

# Image versions (DockerHub tags).
EXAM_SERVICE_VERSION=1.0.0
WORLD_SERVICE_VERSION=1.0.0

# Services not in this stack yet. Empty means mocked by the caller.
PLAYER_SERVICE_URL=
RESOURCE_SERVICE_URL=
CRAFTING_SERVICE_URL=
GAME_SERVICE_URL=
